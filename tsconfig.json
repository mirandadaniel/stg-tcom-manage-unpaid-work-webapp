{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compileOnSave": true,
  "compilerOptions": {
    "outDir": "./dist",
    "sourceMap": true,
    "noEmit": true,
    "allowJs": false,
    "strict": false,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "typeRoots": ["./server/@types", "./node_modules/@types"],
    "baseUrl": ".",
    "paths": {}
  },
  "exclude": ["node_modules", "assets/**/*.js", "dist", "esbuild", "eslint.config.mjs", "cypress/**/*.ts", "server/**"],
  "include": ["**/*.js", "**/*.ts", "**/*.tsx", "types/**/*.d.ts"]
}
