{% extends "../../layouts/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}


{% set pageTitle = applicationName + " - View Past Appointment" %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}
{{ govukBackLink({
  text: "Back to Your appointments",
  href: "/pop/appointments" + bypassQuery
}) }}

<h1 class="govuk-heading-xl">View past appointment</h1>

<div class="govuk-summary-card">
  <div class="govuk-summary-card__title-wrapper">
    <h2 class="govuk-summary-card__title">Appointment details</h2>
  </div>
  <div class="govuk-summary-card__content">
    <dl class="govuk-summary-list">
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Meeting point</dt>
        <dd class="govuk-summary-list__value">123 Garden Street, London SE1 7TH</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Date</dt>
        <dd class="govuk-summary-list__value">Monday 20 Jan 2025</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Time</dt>
        <dd class="govuk-summary-list__value">9am - 5pm</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Your behavior and attitude</dt>
        <dd class="govuk-summary-list__value">Excellent</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Supervisor comments</dt>
        <dd class="govuk-summary-list__value">
          Great work on the skirting board. Appreciate you keeping the energy up even after 3pm
        </dd>
      </div>
    </dl>
  </div>
</div>
{% endblock %}
