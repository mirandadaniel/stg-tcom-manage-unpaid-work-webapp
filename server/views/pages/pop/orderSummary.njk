{% extends "../../layouts/layout.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% set pageTitle = applicationName + " - Your conditions summary" %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}
{{ govukBackLink({
  text: "Back to homepage",
  href: "/pop" + bypassQuery
}) }}

<h1 class="govuk-heading-xl">Your conditions</h1>

<p class="govuk-body">
  You must follow these conditions to avoid returning to court, being given additional requirements, or being sent to prison.
</p>

<div class="govuk-summary-card">
  <div class="govuk-summary-card__title-wrapper">
    <h2 class="govuk-summary-card__title">Order details</h2>
  </div>
  <div class="govuk-summary-card__content">
    <dl class="govuk-summary-list">
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Order type</dt>
        <dd class="govuk-summary-list__value">{{ orderSummary.orderType }}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Order start date</dt>
        <dd class="govuk-summary-list__value">{{ orderSummary.startDate }}</dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Order estimated end date</dt>
        <dd class="govuk-summary-list__value">{{ orderSummary.requirementsCompletionDate }}</dd>
      </div>
    </dl>
  </div>
</div>

<div class="govuk-summary-card">
  <div class="govuk-summary-card__title-wrapper">
    <h2 class="govuk-summary-card__title">Order requirements</h2>
  </div>
  <div class="govuk-summary-card__content">
    <dl class="govuk-summary-list">
      {% for requirement in orderSummary.requirements %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ requirement.category }}</dt>
          <dd class="govuk-summary-list__value">{{ requirement.requirement }}</dd>
        </div>
      {% endfor %}
    </dl>
  </div>
</div>

<p class="govuk-body">
  <a href="/pop/probation-conditions{{ bypassQuery }}" target="_blank" class="govuk-link">
    View what probation expects of you (opens in a new tab)
  </a>
</p>
{% endblock %}
