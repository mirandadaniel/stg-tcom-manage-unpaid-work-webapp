{%- from "moj/components/alert/macro.njk" import mojAlert -%}

{% extends "../../layouts/layout.njk" %}

{% set pageTitle = applicationName + " - Home" %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}

<h1 class="govuk-heading-xl">Welcome, Joe</h1>

{% if scenario == "missed" %}
{{ mojAlert({
  variant: "error",
  title: "Missed appointment on 10 March 2025",
  showTitleAsHeading: true,
  dismissible: false,
  html: 'You failed to attend your scheduled probation appointment on 10 March 2025. You have until 15 March 2025 to respond to this notice and explain why you missed this appointment. If you fail to do that, this might count as a breach of your supervision requirement and enforcement action might be taken.'
}) }}
{% endif %}

{% if scenario == "reminder" %}
{{ mojAlert({
  variant: "information",
  title: "Appointment reminder",
  showTitleAsHeading: true,
  dismissible: false,
  html: 'You have an appointment booked for 15 March 2025 at 9am. <a href="/pop/view-appointment">View your appointment</a> if you need to reschedule it.'
}) }}
{% endif %}

{% if (session.popVerificationStatus == "pending" or scenario == "pending") %}
{{ mojAlert({
  variant: "warning",
  title: "Account pending verification",
  showTitleAsHeading: true,
  dismissible: false,
  html: 'Your account has been created and will be verified after your next face-to-face appointment with your probation practitioner.
  <br /> Once your account is activated you will be able to acccess the links below.'
}) }}
{% endif %}

{% if (session.popVerificationStatus == "verified" or scenario == "verified") %}

{{ mojAlert({
  variant: "success",
  title: "Account verified",
  showTitleAsHeading: true,
  dismissible: true,
  html: 'Your account has been verified by your probation practitioner'
}) }}
{% endif %}

<div class="govuk-card-grid">
  {% if (session.popVerificationStatus == "pending" or scenario == "pending") %}
    <a class="govuk-card-link" href="/pop/your-details{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Your details</h2>
      <p class="govuk-card-link__description">View your personal information</p>
    </a>
    <a class="govuk-card-link" href="/pop/your-progress{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Your progress</h2>
      <p class="govuk-card-link__description">Track your community order progress</p>
    </a>
    <a class="govuk-card-link" href="/pop/appointments{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Past and upcoming appointments</h2>
      <p class="govuk-card-link__description">View your scheduled sessions</p>
    </a>
    <a class="govuk-card-link" href="/pop/conditions{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Your conditions</h2>
      <p class="govuk-card-link__description">View the conditions of your order</p>
    </a>
  {% else %}
    <a class="govuk-card-link" href="/pop/your-details{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Your details</h2>
      <p class="govuk-card-link__description">View your personal information</p>
    </a>
    <a class="govuk-card-link" href="/pop/your-progress{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Your progress</h2>
      <p class="govuk-card-link__description">Track your community order progress</p>
    </a>
    <a class="govuk-card-link" href="/pop/appointments{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Past and upcoming appointments</h2>
      <p class="govuk-card-link__description">View your scheduled sessions</p>
    </a>
    <a class="govuk-card-link" href="/pop/conditions{{ bypassQuery }}">
      <h2 class="govuk-card-link__title">Your conditions</h2>
      <p class="govuk-card-link__description">View the conditions of your order</p>
    </a>
  {% endif %}
</div>

{% endblock %}
